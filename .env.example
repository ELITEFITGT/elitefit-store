# Copia este archivo como .env (desarrollo) o configura estas variables en tu hosting.
# NO uses el prefijo VITE_ para la clave: esas variables se incluyen en el navegador.

# Obligatoria para activar el asistente. Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcionales (valores por defecto entre paréntesis)
# AI_MODEL=claude-opus-5-5          # modelo con soporte de herramientas
# AI_EFFORT=low                     # low | medium | high | xhigh | max
# AI_MAX_OUTPUT_TOKENS=4096
# AI_FALLBACKS=default              # "off" para desactivar el reintento en otro modelo si se declina
# AI_TIMEOUT_MS=45000
# CHAT_RATE_LIMIT_PER_MINUTE=15     # por IP
# CHAT_RATE_LIMIT_PER_DAY=300       # por IP
# CHAT_MAX_USER_CHARS=1000
# CHAT_MAX_MESSAGES=90
# CHAT_MAX_TOOL_ROUNDS=8
# CHAT_ALLOWED_ORIGINS=             # p. ej. https://www.tutienda.com (vacío = mismo dominio)
