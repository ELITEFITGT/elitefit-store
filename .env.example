# Copia este archivo como .env (desarrollo) o configura estas variables en tu hosting.
# Las variables SIN prefijo VITE_ solo las usa el servidor y nunca llegan al navegador.

# Supabase (Project Settings → API). Usa solo la clave pública anon / publishable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Catálogo: la tienda lee los productos de Supabase con esta clave SOLO en el servidor
# (al iniciar `npm run dev` o al compilar). NUNCA le pongas el prefijo VITE_.
SUPABASE_SECRET_KEY=
# SUPABASE_IMAGE_BUCKET=productos   # bucket de Storage de las fotos (si se guardan como storage_path)

# Pedidos (POST /api/pedidos): se guardan en pedidos_carrito y pedidos_carrito_detalles con SUPABASE_SECRET_KEY.
# Obligatoria: id de un usuario de Supabase Auth (Authentication → Users). Los pedidos web quedan a su nombre
# (pedidos_carrito.usuario_id debe existir en auth.users).
ORDER_USUARIO_ID=
# Valor que se guarda en pedidos_carrito.metodo_entrega para cada modalidad (debe cumplir la regla de la tabla).
# ORDER_DELIVERY_ENVIO=envio_domicilio
# ORDER_DELIVERY_RECOGER=retiro_tienda
